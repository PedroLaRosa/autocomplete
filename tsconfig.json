{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "outDir": "./build",
    "target": "ES2018",
    "module": "ESNext",
    "lib": [
      "ES2018",
      "DOM"
    ],
    "strict": false,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "types": [
      "@withfig/autocomplete-types",
      "node"
    ]
  },
  "exclude": [
    "node_modules/"
  ],
  "include": [
    "./src/**/*",
    "dangerfile.ts"
  ]
}